<?xml version="1.0" encoding="utf-8"?>
<!--
  Config local ao QuickStacks: a maquina de desenvolvimento tem um NuGet.Config de
  usuario com Package Source Mapping restrito a pacotes de um outro projeto (MAUI/
  "Maestria"). Sem isto, o restore falha com NU1100 para Microsoft.WindowsAppSDK,
  Microsoft.Data.Sqlite, CommunityToolkit.Mvvm e H.NotifyIcon.WinUI, que nao estao
  naquela lista.

  Este arquivo so vale para projetos dentro de quickstacks\ (NuGet usa o mais proximo
  na arvore de pastas) - nao afeta o restore do EasyWinMenu.App/EasyWinMenu.Core.
-->
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
