<Window
    x:Class="QuickStacks.UI.DesktopGroupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fase 9 (modo Full): grupo solto na area de trabalho - canvas livre com icones
         arrastaveis, equivalente ao modo Panel do DesktopGroupWindow do EasyWinMenu. Sem
         moldura nativa (ExtendsContentIntoTitleBar) para parecer um painel flutuante, nao uma
         janela de aplicativo comum. -->
    <Grid x:Name="RootGrid">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="ToggleDisplayModeItem" Click="ToggleDisplayMode_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="32" x:Name="HeaderBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="0"
                Margin="10,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                Content="✕"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseButton_Click" />
        </Grid>

        <Canvas x:Name="IconCanvas" Grid.Row="1" AllowDrop="True" Drop="IconCanvas_Drop" DragOver="IconCanvas_DragOver" />

        <!-- Fase 10: modo App Folder - ladrilho fechado (mosaico + selo) em vez do canvas
             aberto; construido em codigo (BuildAppFolderTile) igual aos ladrilhos do Panel,
             ja' que este projeto nao usa DataTemplate declarativo pra essas celulas. -->
        <Grid x:Name="AppFolderRoot" Grid.Row="1" Visibility="Collapsed" DoubleTapped="AppFolderRoot_DoubleTapped" />
    </Grid>
</Window>
