<Window
    x:Class="QuickStacks.UI.DesktopGroupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:QuickStacks.Application">

    <!-- Grupo solto na área de trabalho sem barras nativas "WinUI Desktop", cantos arredondados,
         arrasto Win32 nativo, auto-organização de atalhos e busca integrada CTRL+F. -->
    <Grid
        x:Name="RootGrid"
        IsTabStop="True"
        CornerRadius="10"
        BorderThickness="1"
        BorderBrush="#33FFFFFF"
        KeyDown="RootGrid_KeyDown">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.ContextFlyout>
            <MenuFlyout x:Name="GroupContextMenu">
                <MenuFlyoutItem x:Name="AddShortcutMenuItem" Text="Novo atalho..." Click="AddShortcut_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ToggleDisplayModeItem" Click="ToggleDisplayMode_Click" />
                <MenuFlyoutSubItem x:Name="SortSubItem" Text="Organizar atalhos">
                    <MenuFlyoutItem x:Name="SortByNameItem" Text="Por nome (A-Z)" Click="SortByName_Click" />
                    <MenuFlyoutItem x:Name="SortByTypeItem" Text="Por tipo" Click="SortByType_Click" />
                    <MenuFlyoutItem x:Name="SortByRecentItem" Text="Mais usados" Click="SortByRecent_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="ShadowSubItem" Text="Sombra do grupo">
                    <ToggleMenuFlyoutItem x:Name="Shadow135Item" Text="Inferior direito (135° - Padrão)" Click="ShadowAngle_Click" Tag="135" />
                    <ToggleMenuFlyoutItem x:Name="Shadow90Item" Text="Inferior (90°)" Click="ShadowAngle_Click" Tag="90" />
                    <ToggleMenuFlyoutItem x:Name="Shadow225Item" Text="Inferior esquerdo (225°)" Click="ShadowAngle_Click" Tag="225" />
                    <ToggleMenuFlyoutItem x:Name="Shadow45Item" Text="Superior direito (45°)" Click="ShadowAngle_Click" Tag="45" />
                    <ToggleMenuFlyoutItem x:Name="ShadowNoneItem" Text="Desativada" Click="ShadowAngle_Click" Tag="-1" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="SearchMenuItem" Text="Pesquisar (Ctrl+F)" Click="SearchMenu_Click" />
                <MenuFlyoutItem x:Name="EditStructureItem" Text="Editar estrutura..." Click="EditStructure_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="CloseGroupMenuItem" Text="Fechar grupo" Click="CloseButton_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Cabeçalho com arrasto nativo fluido -->
        <Grid
            Grid.Row="0"
            Height="34"
            x:Name="HeaderBar"
            PointerPressed="HeaderBar_PointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="0"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                FontSize="13"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0">
                <Button
                    x:Name="SearchButton"
                    AutomationProperties.Name="Pesquisar (Ctrl+F)"
                    AutomationProperties.AutomationId="SearchButton"
                    Content="&#xE721;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="12"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Pesquisar (Ctrl+F)"
                    Click="SearchMenu_Click" />
                <Button
                    x:Name="CloseButton"
                    AutomationProperties.Name="Fechar grupo"
                    AutomationProperties.AutomationId="CloseButton"
                    Content="✕"
                    FontSize="12"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Fechar grupo"
                    Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Faixa de busca flutuante CTRL+F com lista suspensa inteligente -->
        <Grid Grid.Row="1" x:Name="SearchBarRow" Visibility="Collapsed" Margin="8,0,8,6">
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.Name="Pesquisar atalhos"
                AutomationProperties.AutomationId="SearchBox"
                PlaceholderText="Pesquisar atalhos (Ctrl+F)..."
                QueryIcon="Find"
                HorizontalAlignment="Stretch"
                TextChanged="SearchBox_TextChanged"
                SuggestionChosen="SearchBox_SuggestionChosen"
                QuerySubmitted="SearchBox_QuerySubmitted"
                KeyDown="SearchBox_KeyDown">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="app:MenuEntryViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="2">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <!-- Área de atalhos em grade auto-organizada -->
        <Canvas
            x:Name="IconCanvas"
            Grid.Row="2"
            AllowDrop="True"
            Drop="IconCanvas_Drop"
            DragOver="IconCanvas_DragOver" />

        <!-- Modo App Folder (Ladrilho compacto 110x140 com cantos arredondados, mosaico e badge) -->
        <Grid
            x:Name="AppFolderRoot"
            Grid.Row="0"
            Grid.RowSpan="3"
            Visibility="Collapsed"
            PointerPressed="AppFolderRoot_PointerPressed"
            DoubleTapped="AppFolderRoot_DoubleTapped" />
    </Grid>
</Window>
