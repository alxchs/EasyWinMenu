<Application
    x:Class="QuickStacks.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Os estilos padrao de boa parte do catalogo WinUI (TreeView, BreadcrumbBar,
        RadioMenuFlyoutItem...) moram neste dicionario. Sem ele, aplicar qualquer um desses
        controles derruba o processo inteiro com STATUS_STOWED_EXCEPTION (0xC000027B) - foi
        o que fazia o editor de estrutura cair ao abrir. So' carrega se a app tiver seu
        proprio resources.pri, que o QuickStacks.UI.csproj agora gera de verdade.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
