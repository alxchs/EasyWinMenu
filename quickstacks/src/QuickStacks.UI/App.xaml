<Application
    x:Class="QuickStacks.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Os estilos padrao de boa parte do catalogo WinUI (TreeView, BreadcrumbBar,
        RadioMenuFlyoutItem...) moram neste dicionario. Sem ele, aplicar qualquer um desses
        controles derruba o processo inteiro com STATUS_STOWED_EXCEPTION (0xC000027B).

        Ele so' carrega se a app tiver seu proprio arquivo .pri - ou seja, depende da etapa
        de MRT/PRI que o QuickStacks.UI.csproj agora liga de verdade, localizando a
        ferramenta AppxPackage do MSBuild. Ver secao 6.25 da especificacao tecnica.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
