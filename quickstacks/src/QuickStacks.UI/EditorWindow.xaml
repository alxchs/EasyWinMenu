<Window
    x:Class="QuickStacks.UI.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:QuickStacks.Application">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Name="AddFolderButton" Icon="NewFolder" Click="AddFolder_Click" />
            <AppBarButton x:Name="AddItemButton" Icon="Add" Click="AddItem_Click" />
            <AppBarButton x:Name="RenameButton" Icon="Rename" Click="Rename_Click" />
            <AppBarButton x:Name="EditButton" Icon="Edit" Click="Edit_Click" />
            <AppBarButton x:Name="DeleteButton" Icon="Delete" Click="Delete_Click" />
            <AppBarSeparator />
            <AppBarButton x:Name="ExportButton" Icon="Save" Click="Export_Click" />
            <AppBarButton x:Name="ImportButton" Icon="OpenFile" Click="Import_Click" />
            <AppBarButton x:Name="ImportLnkButton" Icon="Link" Click="ImportLnk_Click" />
            <AppBarSeparator x:Name="DesktopGroupSeparator" />
            <AppBarButton x:Name="ToggleDesktopGroupButton" Icon="Pin" Click="ToggleDesktopGroup_Click" />
        </CommandBar>

        <!-- Arvore achatada em ListView, com indentacao e seta de expandir feitas a mao.
             NAO usar TreeView aqui: o estilo padrao dela mora no dicionario Fluent, que esta
             app (desempacotada, com EnableCoreMrtTooling=false por falta da task de PRI do
             Visual Studio) nao consegue mergear - aplicar a TreeView derrubava o processo
             inteiro com STATUS_STOWED_EXCEPTION ao abrir o editor. Mesmo precedente do
             BreadcrumbBar (Fase 14) e do RadioMenuFlyoutItem (Fase 6). Ver secao 6.25 da
             especificacao tecnica. O GridView do popup ja provava que ListViewBase funciona
             sem o dicionario. -->
        <ListView
            x:Name="Tree"
            Grid.Row="1"
            Margin="8"
            SelectionMode="Single"
            CanDragItems="True"
            AllowDrop="True"
            SelectionChanged="Tree_SelectionChanged"
            DragItemsStarting="Tree_DragItemsStarting"
            ItemsSource="{x:Bind ViewModel.VisibleNodes}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="app:MenuTreeNodeViewModel">
                    <!-- O alvo de soltar e' a linha inteira: a posicao vertical do ponteiro
                         dentro dela decide entre reordenar (bordas) e reparentar (meio). -->
                    <Border
                        Background="Transparent"
                        AutomationProperties.Name="{x:Bind Name}"
                        AllowDrop="True"
                        DragOver="TreeItem_DragOver"
                        Drop="TreeItem_Drop">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                            <Border Width="{x:Bind Indent}" />
                            <Button
                                Click="Expander_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4"
                                MinWidth="24"
                                Visibility="{x:Bind HasChildren}">
                                <FontIcon Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" FontSize="10" />
                            </Button>
                            <Border Width="24" Visibility="{x:Bind HasNoChildren}" />
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
