<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>QuickStacks.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- App nao empacotada (sem MSIX) por enquanto - mais simples de depurar; empacotamento
         entra na fase de distribuicao corporativa do plano. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\quickstacks.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    MRT/PRI: sem o resources.pri gerado por esta etapa, nenhum 'ms-appx:///' resolve, o
    dicionario Fluent (XamlControlsResources) nao pode ser mergeado no App.xaml, e todo
    controle cujo estilo padrao mora nele derruba o processo com STATUS_STOWED_EXCEPTION.
    Foi a causa-raiz de quatro contornos nas fases anteriores (RadioMenuFlyoutItem,
    BreadcrumbBar, TreeView e o IncludeXbfInPublishOutput mais abaixo).

    MrtCore.PriGen.targets procura Microsoft.Build.Packaging.Pri.Tasks.dll em
    $(AppxMSBuildToolsPath), cujo padrao aponta para dentro do SDK do dotnet - onde ela
    nunca esta. A DLL vem do componente "AppxPackage" do MSBuild do Visual Studio. Em vez
    de fixar um caminho de maquina, procuramos a instalacao real; quando nao houver
    nenhuma, a build volta ao modo degradado de antes em vez de quebrar.
  -->
  <!--
    A busca tem de acontecer em tempo de AVALIACAO: o MrtCore.PriGen.targets le
    AppxMSBuildToolsPath fora de qualquer Target e ja' o usa no UsingTask, entao definir a
    propriedade dentro de um Target seria tarde demais. Isso descarta glob por item
    (@(...) nao existe ainda quando as propriedades sao avaliadas) - daqui a cadeia
    explicita de candidatos, que tambem e' mais rapida que varrer a arvore da VS.

    Quem estiver fora deste layout padrao (instalacao em outro disco, versao mais nova)
    passa o caminho pronto: `-p:AppxMSBuildToolsPath=...\AppxPackage\`. E' o que o
    tools\build_installer.ps1 faz, descobrindo a instalacao pelo vswhere oficial.
  -->
  <PropertyGroup>
    <_AppxTail>MSBuild\Microsoft\VisualStudio</_AppxTail>
    <_AppxProbe1>$(ProgramW6432)\Microsoft Visual Studio\2022\Enterprise\$(_AppxTail)\v17.0\AppxPackage\</_AppxProbe1>
    <_AppxProbe2>$(ProgramW6432)\Microsoft Visual Studio\2022\Professional\$(_AppxTail)\v17.0\AppxPackage\</_AppxProbe2>
    <_AppxProbe3>$(ProgramW6432)\Microsoft Visual Studio\2022\Community\$(_AppxTail)\v17.0\AppxPackage\</_AppxProbe3>
    <_AppxProbe4>$(ProgramW6432)\Microsoft Visual Studio\2022\BuildTools\$(_AppxTail)\v17.0\AppxPackage\</_AppxProbe4>
  </PropertyGroup>

  <PropertyGroup>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_AppxProbe1)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_AppxProbe1)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_AppxProbe2)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_AppxProbe2)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_AppxProbe3)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_AppxProbe3)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_AppxProbe4)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_AppxProbe4)</AppxMSBuildToolsPath>

    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <EnableCoreMrtTooling Condition="Exists('$(AppxMSBuildToolsPath)Microsoft.Build.Packaging.Pri.Tasks.dll')">true</EnableCoreMrtTooling>
  </PropertyGroup>

  <Target Name="ReportMrtToolingState" BeforeTargets="BeforeBuild">
    <Message Importance="high" Condition="'$(EnableCoreMrtTooling)' == 'true'" Text="[QuickStacks] MRT/PRI ligado - ferramenta AppxPackage em $(AppxMSBuildToolsPath)" />
    <Warning Condition="'$(EnableCoreMrtTooling)' != 'true'" Text="[QuickStacks] Ferramenta AppxPackage do MSBuild nao encontrada: sem resources.pri, o dicionario Fluent nao carrega e controles como TreeView derrubam o app. Instale o Visual Studio com o workload de desenvolvimento para a plataforma Windows Universal." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickStacks.Application\QuickStacks.Application.csproj" />
    <ProjectReference Include="..\QuickStacks.Infrastructure\QuickStacks.Infrastructure.csproj" />
    <ProjectReference Include="..\QuickStacks.Localization\QuickStacks.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\quickstacks.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\quickstacks-placeholder.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- `dotnet publish` filtra a saida por @(ResolvedFileToPublish), e nem o XAML compilado
       (.xbf) nem o .pri gerado entram nessa lista sozinhos: os .xbf ficam parados no obj/ e o
       .pri no bin/. Sem os .xbf, o app publicado morre com XamlParseException("XAML parsing
       failed.") ja' na primeira janela, porque LoadComponent nao acha o .xbf correspondente;
       sem o .pri, nenhum 'ms-appx:///' resolve e o dicionario Fluent nao carrega. `dotnet
       build` (Debug) nao sofre disso porque copia por outro caminho.

       Com o MRT ligado este contorno dos .xbf deixa de ser necessario (a propria etapa leva
       os .xbf para a saida) e passa a ATRAPALHAR: o compilador XAML tambem emite uma copia
       em obj\...\embed\, e o glob abaixo pegaria as duas, colidindo no mesmo caminho
       relativo (NETSDK1152). Por isso ele so' vale no modo degradado. -->
  <Target Name="IncludeXbfInPublishOutput"
          BeforeTargets="AssignTargetPaths;ComputeFilesToPublish"
          Condition="'$(EnableCoreMrtTooling)' != 'true'">
    <ItemGroup>
      <_GeneratedXbf Include="$(IntermediateOutputPath)**\*.xbf" />
      <None Include="@(_GeneratedXbf)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>

  <!-- O .pri so' existe depois que a etapa de MRT roda, entao entra na lista de publicacao
       direto, e nao como @(None) resolvido antes da build. Publicado tambem como
       resources.pri: desempacotado, e' esse o nome que o MRT Core procura na pasta do exe. -->
  <Target Name="IncludeProjectPriInPublishOutput"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(EnableCoreMrtTooling)' == 'true' and Exists('$(ProjectPriFullPath)')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>resources.pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
