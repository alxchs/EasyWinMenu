<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>QuickStacks.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- App nao empacotada (sem MSIX) por enquanto - mais simples de depurar; empacotamento
         entra na fase de distribuicao corporativa do plano. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Maquina de dev so tem o dotnet SDK (sem Visual Studio) - MrtCore.PriGen.targets
         precisa de Microsoft.Build.Packaging.Pri.Tasks.dll, que so vem com o componente
         "AppxPackage" do MSBuild da VS e nao existe aqui. Sem .resw/MRT assets nesta fase,
         resources.pri nao faz falta; reavaliar se a fase de i18n (.resw) precisar dele -
         nesse caso, builda numa maquina com Visual Studio + workload de Windows App SDK. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickStacks.Application\QuickStacks.Application.csproj" />
    <ProjectReference Include="..\QuickStacks.Infrastructure\QuickStacks.Infrastructure.csproj" />
    <ProjectReference Include="..\QuickStacks.Localization\QuickStacks.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\quickstacks-placeholder.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- EnableCoreMrtTooling=false (acima) tambem desliga o passo que copiaria os .xbf (XAML
       compilado) pro output publicado - ficam parados so' no obj/, e o app publicado falha
       com XamlParseException("XAML parsing failed.") ao tentar montar QUALQUER janela, ja' na
       primeira (TrayIconWindow), porque LoadComponent nao acha o .xbf correspondente. `dotnet
       build` (Debug) nao sofre disso porque copia o obj/ inteiro pro bin/ por outro caminho;
       so' `dotnet publish` filtra por @(ResolvedFileToPublish). Fix: incluir os .xbf gerados
       nessa lista a mao. -->
  <Target Name="IncludeXbfInPublishOutput" BeforeTargets="AssignTargetPaths;ComputeFilesToPublish">
    <ItemGroup>
      <_GeneratedXbf Include="$(IntermediateOutputPath)**\*.xbf" />
      <None Include="@(_GeneratedXbf)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>

</Project>
