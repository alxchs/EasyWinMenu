<Window
    x:Class="QuickStacks.UI.TrayIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid>
        <!-- Os textos sao preenchidos em codigo (RefreshTexts) porque XAML puro nao tem como
             ler o dicionario de idioma do LocalizationService (isso e' o que x:Uid faria via
             .resw/MRT, ferramenta que nao existe nesta maquina - ver secao 4 do doc tecnico).
             RefreshTexts roda uma vez no construtor e de novo a cada LocalizationService.LanguageChanged. -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="QuickStacks"
            LeftClickCommand="{x:Bind ShowPopupCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="OpenItem" Command="{x:Bind ShowPopupCommand}" />
                    <MenuFlyoutItem x:Name="EditStructureItem" Command="{x:Bind OpenEditorCommand}" />
                    <!-- ToggleMenuFlyoutItem, nao RadioMenuFlyoutItem: RadioMenuFlyoutItem
                         trava/crasha o processo nesta maquina assim que o menu de contexto e'
                         montado (reproduzido isolado - ver secao 4 do doc tecnico). Sem
                         agrupamento nativo, a exclusividade mutua e' feita a mao no
                         code-behind (deixar so o item escolhido marcado). -->
                    <MenuFlyoutSubItem x:Name="ThemeSubItem">
                        <ToggleMenuFlyoutItem x:Name="ThemeLightItem" Click="ThemeLight_Click" />
                        <ToggleMenuFlyoutItem x:Name="ThemeDarkItem" Click="ThemeDark_Click" />
                        <ToggleMenuFlyoutItem x:Name="ThemeSystemItem" Click="ThemeSystem_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="LanguageSubItem">
                        <ToggleMenuFlyoutItem x:Name="LanguagePtBrItem" Text="Português (Brasil)" Click="LanguagePtBr_Click" />
                        <ToggleMenuFlyoutItem x:Name="LanguageEnUsItem" Text="English (US)" Click="LanguageEnUs_Click" />
                        <ToggleMenuFlyoutItem x:Name="LanguageEsEsItem" Text="Español (España)" Click="LanguageEsEs_Click" />
                        <ToggleMenuFlyoutItem x:Name="LanguageDeDeItem" Text="Deutsch (Deutschland)" Click="LanguageDeDe_Click" />
                    </MenuFlyoutSubItem>
                    <!-- Fase 8: Lite (como sempre foi) vs Full (tudo do EasyWinMenu, roteiro
                         nas fases 8-20). -->
                    <MenuFlyoutSubItem x:Name="TierSubItem">
                        <ToggleMenuFlyoutItem x:Name="TierLiteItem" Click="TierLite_Click" />
                        <ToggleMenuFlyoutItem x:Name="TierFullItem" Click="TierFull_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ExitItem" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
