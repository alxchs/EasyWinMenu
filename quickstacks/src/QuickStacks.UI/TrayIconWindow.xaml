<Window
    x:Class="QuickStacks.UI.TrayIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="QuickStacks"
            LeftClickCommand="{x:Bind ShowPopupCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Abrir" Command="{x:Bind ShowPopupCommand}" />
                    <MenuFlyoutItem Text="Editar estrutura..." Command="{x:Bind OpenEditorCommand}" />
                    <MenuFlyoutSubItem Text="Tema">
                        <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="Claro" GroupName="Theme" Click="ThemeLight_Click" />
                        <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="Escuro" GroupName="Theme" Click="ThemeDark_Click" />
                        <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="Seguir Windows" GroupName="Theme" Click="ThemeSystem_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Sair" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
