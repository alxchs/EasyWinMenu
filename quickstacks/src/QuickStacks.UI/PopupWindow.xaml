<Window
    x:Class="QuickStacks.UI.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:QuickStacks.Application">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fase 3: busca global (RF10) + atalhos para as listas globais (RF09/RF11/RF13). -->
        <Grid Grid.Row="0" Margin="12,10,12,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                TextChanged="SearchBox_TextChanged" />
            <Button x:Name="FavoritesButton" Grid.Column="1" Content="★" Click="ShowFavorites_Click" />
            <Button x:Name="RecentButton" Grid.Column="2" Content="🕐" Click="ShowRecent_Click" />
            <Button x:Name="MostUsedButton" Grid.Column="3" Content="🔥" Click="ShowMostUsed_Click" />
        </Grid>

        <!-- Requisito 1: navegacao dentro do grupo como pasta do Windows (trilha in-place,
             nunca uma janela nova por subpasta). So' faz sentido no modo Folder - nas vistas
             globais (favoritos/recentes/busca) a trilha some, ja' que os resultados podem vir
             de qualquer nivel da arvore. -->
        <!-- Trilha construida a mao em vez do BreadcrumbBar nativo: BreadcrumbBar trava o
             processo com uma falha nativa irrecuperavel ao ser construido nesta maquina (sem
             excecao gerenciada capturavel - confirmado via dump de crash, mesma familia de
             causa das outras falhas nativas ja documentadas neste ambiente: um controle Fluent
             mais novo cuja folha de estilo padrao depende de recursos que App.xaml nao tem
             mergeados). Mesmo padrao ja usado no DesktopGroupWindow: StackPanel + Button
             simples em vez de um controle "pronto" com dependencias de tema obscuras. -->
        <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" Grid.Row="1" Margin="12,10" Spacing="4" />

        <!-- Requisitos 2 e 3: drag-and-drop entre pastas / para o Explorer, e reflow
             automatico ao redimensionar (GridView com layout de grade nativo, sem
             matematica de coluna manual). -->
        <GridView
            x:Name="ItemsGrid"
            Grid.Row="2"
            Margin="4"
            SelectionMode="Extended"
            IsItemClickEnabled="False"
            CanDragItems="True"
            AllowDrop="True"
            ItemsSource="{x:Bind ViewModel.Items}"
            DragItemsStarting="ItemsGrid_DragItemsStarting"
            DoubleTapped="ItemsGrid_DoubleTapped"
            KeyDown="ItemsGrid_KeyDown">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="app:MenuEntryViewModel">
                    <StackPanel
                        Width="96"
                        Padding="10,12"
                        Spacing="6"
                        AllowDrop="True"
                        DragOver="ItemContainer_DragOver"
                        Drop="ItemContainer_Drop">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout Opening="ItemContextFlyout_Opening">
                                <MenuFlyoutItem Click="ToggleFavorite_Click" />
                                <MenuFlyoutItem Click="SetFolderColor_Click" Visibility="{x:Bind IsFolder}" />
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>
                        <Grid HorizontalAlignment="Center">
                            <Image
                                Source="{x:Bind IconPath}"
                                Width="32"
                                Height="32"
                                Visibility="{x:Bind HasCustomIcon}" />
                            <FontIcon
                                Glyph="{x:Bind Glyph}"
                                FontSize="32"
                                Visibility="{x:Bind HasNoCustomIcon}" />
                            <TextBlock
                                Text="★"
                                FontSize="12"
                                Foreground="Gold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind IsFavorite}" />
                        </Grid>
                        <TextBlock
                            Text="{x:Bind Name}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Window>
