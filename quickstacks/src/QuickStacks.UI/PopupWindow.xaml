<Window
    x:Class="QuickStacks.UI.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:QuickStacks.Application">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Requisito 1: navegacao dentro do grupo como pasta do Windows (trilha in-place,
             nunca uma janela nova por subpasta). -->
        <BreadcrumbBar
            x:Name="Breadcrumb"
            Grid.Row="0"
            Margin="12,10"
            ItemsSource="{x:Bind ViewModel.Breadcrumb}"
            ItemClicked="Breadcrumb_ItemClicked">
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="app:BreadcrumbNodeViewModel">
                    <TextBlock Text="{x:Bind Name}" />
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>

        <!-- Requisitos 2 e 3: drag-and-drop entre pastas / para o Explorer, e reflow
             automatico ao redimensionar (GridView com layout de grade nativo, sem
             matematica de coluna manual). -->
        <GridView
            x:Name="ItemsGrid"
            Grid.Row="1"
            Margin="4"
            SelectionMode="Extended"
            IsItemClickEnabled="False"
            CanDragItems="True"
            AllowDrop="True"
            ItemsSource="{x:Bind ViewModel.Items}"
            DragItemsStarting="ItemsGrid_DragItemsStarting"
            DoubleTapped="ItemsGrid_DoubleTapped"
            KeyDown="ItemsGrid_KeyDown">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="app:MenuEntryViewModel">
                    <StackPanel
                        Width="96"
                        Padding="10,12"
                        Spacing="6"
                        AllowDrop="True"
                        DragOver="ItemContainer_DragOver"
                        Drop="ItemContainer_Drop">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind Name}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Window>
